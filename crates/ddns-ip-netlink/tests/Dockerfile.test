# Multi-stage Dockerfile for Netlink Integration Tests
#
# This Dockerfile builds a minimal Linux environment for running
# ddns-ip-netlink integration tests with real netlink sockets.
#
# Build: docker build -f Dockerfile.test -t ddns-netlink-test ../../
# Run:   docker run --rm --privileged ddns-netlink-test

# Stage 1: Builder
FROM rust:latest AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    iproute2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy source code
COPY . .

# Build tests
RUN cargo build --tests -p ddns-ip-netlink

# Stage 2: Test Runtime
FROM debian:latest-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    iproute2 \
    iputils-ping \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy test binaries from builder
COPY --from=builder /app/target/debug/deps/* /tests/
COPY --from=builder /app/target/debug/ddns-ip-netlink-* /tests/

WORKDIR /tests

# Set environment for testing
ENV RUST_LOG=debug
ENV RUST_BACKTRACE=1

# Run all netlink tests by default
CMD ["/bin/bash", "-c", "for test in ddns-ip-netlink-*; do echo \"Running $test...\" && ./$test --ignored || exit 1; done"]
